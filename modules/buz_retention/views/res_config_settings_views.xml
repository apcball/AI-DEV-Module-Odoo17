<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_retention" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.retention</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Retention" string="Retention">
                    <h2>Retention</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="retention_journal_id"/>
                                <field name="retention_journal_id" options="{'no_create': True}"/>
                                <div class="text-muted">
                                    General journal used to post retention offset entries.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="retention_account_id"/>
                                <field name="retention_account_id" options="{'no_create': True}"/>
                                <div class="text-muted">
                                    Expense or clearing account used when creating retention vendor bills.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
