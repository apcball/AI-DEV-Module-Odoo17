<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_retention" model="ir.ui.view">
        <field name="name">account.move.form.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_apply_retention_bill"
                        type="object"
                        string="Apply Retention Bill"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Retention">
                    <group>
                        <field name="retention_bill_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"
                               domain="[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('company_id', '=', company_id), ('amount_residual', '>', 0)]"/>
                        <field name="retention_total_amount" readonly="1"/>
                        <field name="retention_offset_move_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
