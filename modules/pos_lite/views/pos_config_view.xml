<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_lite_config_tree" model="ir.ui.view">
        <field name="name">pos.lite.config.tree</field>
        <field name="model">pos.lite.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="warehouse_id"/>
                <field name="pricelist_id"/>
                <field name="journal_id"/>
                <field name="session_count"/>
                <field name="open_session_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_lite_config_form" model="ir.ui.view">
        <field name="name">pos.lite.config.form</field>
        <field name="model">pos.lite.config</field>
        <field name="arch" type="xml">
            <form string="POS Lite Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button name="action_open_session" type="object" class="oe_stat_button" icon="fa-play-circle">
                            <field name="open_session_count" widget="statinfo" string="Open Sessions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Configuration Name"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Defaults">
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Session Overview">
                            <field name="session_ids" nolabel="1" readonly="1">
                                <tree decoration-success="state == 'open'" decoration-muted="state == 'closed'" decoration-info="state == 'draft'">
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="user_id"/>
                                    <field name="order_count"/>
                                    <field name="amount_total" sum="Net"/>
                                    <field name="amount_paid" sum="Paid"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_lite_config" model="ir.actions.act_window">
        <field name="name">POS Lite Configuration</field>
        <field name="res_model">pos.lite.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
