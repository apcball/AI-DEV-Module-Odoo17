<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_lite_session_tree" model="ir.ui.view">
        <field name="name">pos.lite.session.tree</field>
        <field name="model">pos.lite.session</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'open'" decoration-muted="state == 'closed'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <field name="order_count" sum="Orders"/>
                <field name="amount_total" sum="Net"/>
                <field name="amount_paid" sum="Paid"/>
                <field name="amount_residual" sum="Residual"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_lite_session_search" model="ir.ui.view">
        <field name="name">pos.lite.session.search</field>
        <field name="model">pos.lite.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Configuration" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pos_lite_session_kanban" model="ir.ui.view">
        <field name="name">pos.lite.session.kanban</field>
        <field name="model">pos.lite.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <field name="order_count"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="amount_residual"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="text-truncate d-block"><field name="name"/></strong>
                                    <div class="text-muted small"><field name="config_id"/></div>
                                </div>
                                <span t-attf-class="badge rounded-pill #{'text-bg-success' if record.state.raw_value == 'open' else ('text-bg-secondary' if record.state.raw_value == 'closed' else 'text-bg-info')}">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="small text-muted mb-2">
                                <div><span class="fw-semibold">Company:</span> <field name="company_id"/></div>
                                <div><span class="fw-semibold">Responsible:</span> <field name="user_id"/></div>
                            </div>
                            <div class="row g-2 text-center">
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="fw-semibold"><field name="order_count"/></div>
                                        <div class="text-muted small">Orders</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="fw-semibold"><field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                        <div class="text-muted small">Net</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="fw-semibold"><field name="amount_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                        <div class="text-muted small">Residual</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pos_lite_session_form" model="ir.ui.view">
        <field name="name">pos.lite.session.form</field>
        <field name="model">pos.lite.session</field>
        <field name="arch" type="xml">
            <form string="POS Lite Session">
                <header>
                    <button name="action_open_session" type="object" string="Open Session" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close_session" type="object" string="Close Session" class="btn-secondary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="order_count"/></span>
                                <span class="o_stat_text">Orders</span>
                            </div>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                <span class="o_stat_text">Net Sales</span>
                            </div>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="amount_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                <span class="o_stat_text">Residual</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="config_id" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Session Details">
                            <field name="company_id" readonly="1"/>
                            <field name="user_id"/>
                            <field name="config_id"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group string="Store Setup">
                            <field name="warehouse_id" readonly="1"/>
                            <field name="pricelist_id" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary">
                            <group>
                                <group>
                                    <field name="order_count" readonly="1"/>
                                    <field name="paid_order_count" readonly="1"/>
                                    <field name="done_order_count" readonly="1"/>
                                    <field name="cancelled_order_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="amount_total" readonly="1" widget="monetary"/>
                                    <field name="amount_paid" readonly="1" widget="monetary"/>
                                    <field name="amount_residual" readonly="1" widget="monetary"/>
                                    <field name="amount_change" readonly="1" widget="monetary"/>
                                    <field name="amount_return" readonly="1" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Orders">
                            <field name="order_ids" nolabel="1" readonly="1">
                                <tree decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'" decoration-danger="is_return">
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="channel"/>
                                    <field name="customer_name"/>
                                    <field name="is_return"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="amount_paid" sum="Paid"/>
                                    <field name="amount_residual" sum="Residual"/>
                                    <field name="invoice_id"/>
                                    <field name="picking_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Shift notes, operational reminders, or cashier handover details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_lite_sessions" model="ir.actions.act_window">
        <field name="name">POS Lite Sessions</field>
        <field name="res_model">pos.lite.session</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open a POS Lite session to start processing orders.</p>
        </field>
    </record>
</odoo>
